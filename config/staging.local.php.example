    // Root directory of the staging subdomain (empty string = domain root)
    'LASTO_BASE_PATH' => '',

    // Isolated Staging Database (Must be separate from production DB)
    'LASTO_DB_HOST' => 'localhost',
    'LASTO_DB_PORT' => '3306',
    'LASTO_DB_NAME' => 'REPLACE_WITH_STAGING_CPANEL_DB_NAME',
    'LASTO_DB_USER' => 'REPLACE_WITH_STAGING_CPANEL_DB_USER',
    'LASTO_DB_PASS' => 'REPLACE_WITH_STAGING_STRONG_PASSWORD',

    // Staging Public Origin (HTTPS required)
    'LASTO_PUBLIC_ORIGIN' => 'https://staging-attendance.lastotechnology.my',

    // Isolated session cookie name to prevent session collision with production
    'LASTO_SESSION_NAME' => 'SAS_STAGING_SESSION',

    // Dedicated VAPID credentials for Web Push testing (Generate separate keys for staging)
    // NEVER reuse production VAPID keys on staging.
    'LASTO_VAPID_PUBLIC_KEY' => 'REPLACE_WITH_STAGING_VAPID_PUBLIC_KEY',
