    'LASTO_DB_NAME' => 'REPLACE_WITH_CPANEL_DATABASE_NAME',
    'LASTO_DB_USER' => 'REPLACE_WITH_CPANEL_DATABASE_USER',
    'LASTO_DB_PASS' => 'REPLACE_WITH_LONG_RANDOM_PASSWORD',
    'LASTO_PUBLIC_ORIGIN' => 'https://attendance.lastotechnology.my',
